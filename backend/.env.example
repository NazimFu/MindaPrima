# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=4000
# Comma separated list of origins allowed to call the API (the frontend URL)
CORS_ORIGINS=http://localhost:9002
TZ_NAME=Asia/Kuala_Lumpur
# Time (HH:MM, TZ_NAME) when the daily transport list is rebuilt
TRANSPORT_REFRESH_TIME=05:00

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
BCRYPT_COST=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Set to false only for local http development
COOKIE_SECURE=true

# Google Sheets (the only database). Share the spreadsheet with the service account email.
SHEETS_DRIVER=google
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional: prefix for all tab names, e.g. MP_ (use it if the spreadsheet already has legacy tabs)
SHEET_TAB_PREFIX=
CACHE_TTL_MS=5000

# Rate limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# WhatsApp (whatsapp-web.js)
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=.wwebjs_auth

# First admin, used only by npm run setup:sheets
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when the API runs behind a reverse proxy (so rate limits and secure cookies see the real client).
TRUST_PROXY=0
